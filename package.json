{
  "name": "artsa-monorepo",
  "version": "0.3.0",
  "private": true,
  "description": "ARTSA — Real-Time AI Agent Containment & Escape Detection Platform",
  "scripts": {
    "dev:gateway": "cd backend && ../backend/.venv/bin/python -m uvicorn src.api.main:app --reload --port 8000",
    "dev:frontend": "cd frontend && npm run dev",
    "dev": "concurrently -k -p \"[{name}]\" -n \"BACKEND,FRONTEND\" -c \"cyan,magenta\" \"npm run dev:gateway\" \"npm run dev:frontend\"",
    "build:frontend": "cd frontend && npm run build"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  }
}
