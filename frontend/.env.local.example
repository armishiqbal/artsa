# Frontend environment — copy to .env.local
# ONLY public values here. Never put API keys in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/websocket

# Server-side only (used by the /api/backend proxy route to authenticate to the backend).
# Must match the backend ARTSA_API_KEY when auth is enabled. Never prefix with NEXT_PUBLIC_.
# ARTSA_API_KEY=
# BACKEND_URL=http://localhost:8000
