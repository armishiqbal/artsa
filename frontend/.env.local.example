# Frontend environment — copy to .env.local
# ONLY public values here. Never put API keys in NEXT_PUBLIC_* variables.

NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/websocket
# Optional — must match backend ARTSA_API_KEY when auth is enabled (dev only)
# NEXT_PUBLIC_ARTSA_API_KEY=
