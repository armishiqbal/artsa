# =============================================================================
# ARTSA Platform — Environment Configuration Template
# Copy to .env and fill in your values:  cp .env.example .env
# NEVER commit .env to git. NEVER put secret keys in NEXT_PUBLIC_* vars.
# =============================================================================

# ── Core ─────────────────────────────────────────────────────────────────────
ENVIRONMENT=development
ARTSA_LOG_LEVEL=INFO
# Generate a real value before running (never commit it):
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
ARTSA_API_KEY=
ARTSA_TENANT_ID=default_org
ARTSA_DATA_DIR=./data

# ── Database ─────────────────────────────────────────────────────────────────
# Local dev (default): SQLite — no setup required
USE_SQLITE=true
DATABASE_URL=sqlite+aiosqlite:///./data/artsa.db
SYNC_DATABASE_URL=sqlite:///./data/artsa.db

# Production / Supabase Postgres (set USE_SQLITE=false):
# USE_SQLITE=false
# DATABASE_URL=postgresql+asyncpg://HOST:5432/postgres
# SYNC_DATABASE_URL=postgresql://HOST:5432/postgres

REDIS_URL=redis://localhost:6379/0

# ── Supabase (optional) ──────────────────────────────────────────────────────
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Vector stores ────────────────────────────────────────────────────────────
PINECONE_API_KEY=
PINECONE_ENVIRONMENT=
CHROMA_PERSIST_DIR=./data/chroma

# ── LLM Providers — add at least ONE for wargame campaigns ───────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=
ANTHROPIC_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=
DEEPSEEK_API_KEY=
OPENROUTER_API_KEY=
TOGETHER_API_KEY=
FIREWORKS_API_KEY=
HUGGINGFACE_API_KEY=
HF_TOKEN=
COHERE_API_KEY=
GOOGLE_API_KEY=

# ── Local LLM endpoints (no key required for Ollama) ──────────────────────────
OLLAMA_BASE_URL=http://localhost:11434/v1
# # OLLAMA_API_KEY=ollama  (no auth needed for local Ollama)
VLLM_BASE_URL=http://localhost:8000/v1
VLLM_API_KEY=
LMSTUDIO_BASE_URL=http://localhost:1234/v1
LMSTUDIO_API_KEY=
JAN_BASE_URL=http://localhost:1337/v1
JAN_API_KEY=
LOCAL_BASE_URL=
LOCAL_API_KEY=

# ── Guardrail stacks (optional — enables real defense in wargame) ─────────────
LAKERA_API_KEY=
LAKERA_BASE_URL=https://api.lakera.ai/v2
AZURE_CONTENT_SAFETY_KEY=
AZURE_CONTENT_SAFETY_ENDPOINT=https://YOUR-RESOURCE.cognitiveservices.azure.com
NVIDIA_API_KEY=
NEMO_GUARDRAILS_URL=

# ── ARTSA defaults ───────────────────────────────────────────────────────────
ARTSA_DEFAULT_PROVIDER=openai
ARTSA_DEFAULT_MODEL=gpt-4o
# auto | hash-1024 | local-bge-small | local-minilm | text-embedding-3-small | text-embedding-3-large
# auto = open-source local ONNX model (BAAI/bge-small-en-v1.5 via FastEmbed, offline,
# no API key) when `pip install fastembed` is present, else hash-1024. OpenAI
# embeddings are explicit opt-in only — `auto` never calls a vendor API.
ARTSA_EMBEDDING_MODEL=auto

# ── Org-policy scoring (WS-2.4) ─────────────────────────────────────────────
# Deterministic org-policy rules (configs/org_policies/default.yaml) always
# score; RAG semantic corroboration is opt-in (costs an embedding per call).
# ARTSA_POLICY_RAG_SCORING=false
# ARTSA_ORG_POLICY_PATH=configs/org_policies/default.yaml

# ── LLM-judge verifier (WS-2.3, OFF by default) ─────────────────────────────
# Confirms SUSPICIOUS (50-79) verdicts with a fast judge; escalates to KILL on
# MALICIOUS, never downgrades. Costs one LLM call per borderline event.
# ARTSA_JUDGE_ENABLED=false
# ARTSA_JUDGE_PROVIDER=  (defaults to ARTSA_DEFAULT_PROVIDER)
# ARTSA_JUDGE_MODEL=     (defaults to ARTSA_DEFAULT_MODEL)
# ARTSA_JUDGE_TIMEOUT_SEC=0.6

# Require X-API-Key in production (set ARTSA_API_KEY)
# ARTSA_REQUIRE_AUTH=true

# Production containment defaults (recommended true)
ARTSA_AUTO_ENFORCE=true
ARTSA_BLOCK_CONTAINED_SESSIONS=true

# Wrap all JSON API responses in {"success":bool, "data":..., "meta":{...}}
# All consumers (frontend, Python SDK, TypeScript SDK) unwrap transparently.
ARTSA_RESPONSE_ENVELOPE=true

# ── WebSocket auth tickets ────────────────────────────────────────────────────
# Frontend WebSockets use a short-lived, single-use ticket (?ticket=...) so the
# OIDC bearer token never appears in the WS URL / proxy logs. The ticket is
# signed with ARTSA_WS_TICKET_SECRET (falls back to SECRET_KEY when unset).
# ARTSA_WS_TICKET_SECRET=
# ARTSA_WS_TICKET_TTL_SEC=30

USE_CELERY=false
USE_REDIS_RATE_LIMIT=true
USE_CHROMA_RAG=false
USE_PINECONE_RAG=false
WARM_BENCHMARK_ON_START=false
SEED_ATTACK_LIBRARY_ON_START=false
SCHEDULED_ABLATION_INTERVAL_SEC=0
PINECONE_INDEX_NAME=artsa-policy-kb
PINECONE_NAMESPACE=policy
BENCHMARK_CACHE_TTL_SEC=300

# Comma-separated origins for production CORS (REQUIRED when ENVIRONMENT=production — never *)
# ARTSA_CORS_ORIGINS=https://app.example.com

# ── LLM reverse proxy gateway (drop-in OpenAI/Anthropic guardrail) ────────────
# Point any OpenAI/Anthropic client's base_url at http://localhost:8000/v1/proxy
# to get detection-gated forwarding. See docs/INTEGRATION_GUIDE.md.
ARTSA_PROXY_ENABLED=true
ARTSA_PROXY_DEFAULT_PROVIDER=openai
# ARTSA_PROXY_TARGET_BASE_URL=          # explicit upstream override
# ARTSA_PROXY_API_KEY=                  # upstream key override (defaults to provider key)
# allow | sanitize | block — how SUSPICIOUS prompts are handled
ARTSA_PROXY_MODE=sanitize
ARTSA_PROXY_BLOCK_THRESHOLD=60
ARTSA_PROXY_TIMEOUT_SEC=120
# SSRF guard: proxied forwarding targets (X-ARTSA-Forward-To, provider base_url)
# pointing at private/loopback/link-local hosts are BLOCKED in production.
# Set true to allow internal targets there (e.g. local LLMs / Ollama).
# ARTSA_PROXY_ALLOW_INTERNAL_TARGETS=false

# ── SIEM / SOAR alert channels (enterprise alerting) ─────────────────────────
# Environment-level global integrations. Per-tenant rules can be added via
# POST /api/v1/alerts/integrations instead.
ARTSA_ALERT_RISK_THRESHOLD=60
SLACK_WEBHOOK_URL=
PAGERDUTY_ROUTING_KEY=
PAGERDUTY_SERVICE_URL=https://events.pagerduty.com/v2/enqueue
SPLUNK_HEC_URL=
SPLUNK_HEC_TOKEN=
DATADOG_API_KEY=
DATADOG_SITE=datadoghq.com
SENTINEL_WORKSPACE_ID=
SENTINEL_WORKSPACE_KEY=
SENTINEL_LOG_TYPE=ARTSA_Security
# EXPERIMENTAL: OTEL trace ingest is a heuristic placeholder (no vector drift,
# in-memory only). Disabled by default; the endpoint returns 404 when off.
ARTSA_OTEL_ENABLED=false

# ── OIDC / SSO (optional — Bearer JWT auth alongside API keys) ───────────────
# ARTSA_OIDC_ENABLED=false
# ARTSA_OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# ARTSA_OIDC_AUDIENCE=your-client-id
# ARTSA_OIDC_JWKS_URL=
# ARTSA_OIDC_ROLE_CLAIM=groups
# ARTSA_OIDC_ADMIN_GROUPS=artsa-admin
# ARTSA_OIDC_ANALYST_GROUPS=artsa-analyst
# ARTSA_OIDC_REDTEAM_GROUPS=artsa-redteam
# ARTSA_OIDC_READONLY_GROUPS=artsa-readonly
# ARTSA_OIDC_DEFAULT_ROLE=readonly

# ── RBAC role keys (optional — each maps to a scoped API key) ────────────────
# ARTSA_API_KEY=          # admin — full access
# ARTSA_ANALYST_API_KEY=  # read + write ingest/sessions, no policy admin
# ARTSA_REDTEAM_API_KEY=  # campaigns + ingest only
# ARTSA_READONLY_API_KEY= # GET endpoints only

# Frontend dev API key (optional — matches ARTSA_API_KEY for local auth)
# NEXT_PUBLIC_ARTSA_API_KEY=

# ── Frontend OIDC SSO (optional) ─────────────────────────────────────────────
# NEXT_PUBLIC_OIDC_ENABLED=false
# NEXT_PUBLIC_OIDC_ISSUER=https://login.microsoftonline.com/{tenant}/v2.0
# NEXT_PUBLIC_OIDC_CLIENT_ID=
# NEXT_PUBLIC_OIDC_SCOPE=openid profile email
# OIDC_CLIENT_SECRET=   # server-only — used by /api/auth/token route

# ── Frontend (public — safe to expose, NO secrets here) ──────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_WS_URL=ws://localhost:8000/api/v1/websocket

# ── Local Docker Compose (Postgres) ─────────────────────────────────────────
# docker-compose.yml interpolates this via ${POSTGRES_PASSWORD:-postgrespassword}.
# Override in your shell or .env for local runs — never commit real credentials.
# # POSTGRES_PASSWORD=postgrespassword
