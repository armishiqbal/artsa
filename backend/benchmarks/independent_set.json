  "_meta": {
    "name": "ARTSA independent evaluation set — batch 1",
    "version": "1.0.0",
    "purpose": "Phase 1.1: real-world-style samples curated to exercise GENERALIZATION, not regex matching — obfuscated spellings, multilingual injections, tool-confusion, unusual credential paths, indirect injection. Independently labelled; the independence guard asserts non-duplication vs the generated benchmark. This set is evidence, not a tuning set.",
    "curated": "2026-08-19",
    "note": "No recall floor is applied to this set — it reports the honest generalization gap (the canary gate already shows ~0.56 on these shapes). The floor appears once the Phase-2 obfuscation-normalization work closes the gap."
  },
