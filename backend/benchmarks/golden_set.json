{
  "_meta": {
    "name": "ARTSA golden evaluation set v1",
    "version": "1.0.0",
    "purpose": "Independent, human-curated accuracy evidence — distinct from the generated labeled_dataset_v3.json. Sources: real agent tool-call shapes, security-incident writeups, and ordinary dev/ops workflows. The detector authors did not tune this set.",
    "curated": "2026-08-17",
    "count_note": "labels: malicious = genuine attack tool call; safe = genuine benign operation that must never be flagged (hard availability floor); review = external reference fetch / doc-domain GET that may surface (50-79) but must never KILL (no hard floor)."
  },
  "samples": [
