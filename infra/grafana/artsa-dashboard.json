{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "fieldConfig": {
        "defaults": {
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "green", "value": 1 }
            ]
          }
        }
      },
      "gridPos": { "h": 4, "w": 4, "x": 0, "y": 0 },
      "id": 1,
      "options": { "colorMode": "background", "graphMode": "none", "reduceOptions": { "calcs": ["lastNotNull"] } },
      "title": "ARTSA Up",
      "type": "stat",
      "targets": [{ "expr": "artsa_up", "legendFormat": "up" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 4, "y": 0 },
      "id": 2,
      "title": "Active Sessions",
      "type": "stat",
      "targets": [{ "expr": "artsa_active_sessions", "legendFormat": "sessions" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 8, "y": 0 },
      "id": 3,
      "title": "WebSocket Connections",
      "type": "stat",
      "targets": [{ "expr": "artsa_websocket_connections", "legendFormat": "ws" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 4, "w": 4, "x": 12, "y": 0 },
      "id": 4,
      "title": "Uptime (s)",
      "type": "stat",
      "targets": [{ "expr": "artsa_uptime_seconds", "legendFormat": "uptime" }]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 4 },
      "id": 5,
      "title": "Ingest Rate",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(artsa_ingest_total[5m])",
          "legendFormat": "ingest/s"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 4 },
      "id": 6,
      "title": "Avg Ingest Latency (ms/event)",
      "type": "timeseries",
      "targets": [
        {
          "expr": "rate(artsa_ingest_latency_ms_sum[5m]) / rate(artsa_ingest_total[5m])",
          "legendFormat": "avg ms"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 12 },
      "id": 7,
      "title": "Events by Severity",
      "type": "timeseries",
      "targets": [
        { "expr": "artsa_events_severity_critical", "legendFormat": "CRITICAL" },
        { "expr": "artsa_events_severity_high", "legendFormat": "HIGH" },
        { "expr": "artsa_events_severity_medium", "legendFormat": "MEDIUM" },
        { "expr": "artsa_events_severity_low", "legendFormat": "LOW" }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 12 },
      "id": 8,
      "title": "Benchmark Runs",
      "type": "timeseries",
      "targets": [
        {
          "expr": "increase(artsa_benchmark_runs_total[1h])",
          "legendFormat": "runs/h"
        }
      ]
    }
  ],
  "refresh": "30s",
  "schemaVersion": 39,
  "tags": ["artsa", "containment", "security"],
  "templating": {
    "list": [
      {
        "name": "datasource",
        "type": "datasource",
        "query": "prometheus",
        "current": { "text": "Prometheus", "value": "Prometheus" }
      }
    ]
  },
  "time": { "from": "now-6h", "to": "now" },
  "title": "ARTSA Containment Platform",
  "uid": "artsa-containment",
  "version": 1
}
